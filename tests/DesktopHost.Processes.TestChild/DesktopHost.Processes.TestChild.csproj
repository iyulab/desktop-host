<Project Sdk="Microsoft.NET.Sdk">

  <!-- A child process for the supervisor's tests: behaves as its arguments say, so every test runs the same program on
       every platform. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- `supervise`: the test of a child that outlives a starter killed outright runs a real supervisor in this process. -->
    <ProjectReference Include="..\..\src\DesktopHost.Processes\DesktopHost.Processes.csproj" />
  </ItemGroup>

</Project>
