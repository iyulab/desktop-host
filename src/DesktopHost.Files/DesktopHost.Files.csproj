<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Durable file writes for a local .NET host: atomic replace that a shared reader never sees half of, reads that do not block a writer, retries through the brief locks of scanners and sync clients, naming the process that holds a file, and moving an item to the Recycle Bin / trash without ever deleting it.</Description>
    <PackageTags>file;atomic;replace;durable;retry;lock;restart-manager;recycle-bin;trash;desktop</PackageTags>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Source-generated interop (LibraryImport, GeneratedComInterface) for the Recycle Bin move. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="DesktopHost.Files.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
