<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Durable file writes for a local .NET host: atomic replace that a shared reader never sees half of, reads that do not block a writer, retries through the brief locks of scanners and sync clients, and naming the process that holds a file.</Description>
    <PackageTags>file;atomic;replace;durable;retry;lock;restart-manager;desktop</PackageTags>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
