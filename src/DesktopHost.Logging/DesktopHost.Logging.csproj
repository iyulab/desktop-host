<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>A rotating file log for Microsoft.Extensions.Logging in a local .NET host: one file per day, rolled again at a size limit, bounded by age and by file count, safe to call from any thread and after shutdown.</Description>
    <PackageTags>logging;file;rolling;rotating;retention;desktop</PackageTags>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DesktopHost.Logging.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

</Project>
